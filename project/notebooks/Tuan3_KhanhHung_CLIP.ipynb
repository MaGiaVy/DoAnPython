    "    wrong_preds = [pred for pred in retrieved if pred != i]\n",
    "    wrong_predictions.extend(wrong_preds)\n",
    "\n",
    "wrong_counts = Counter(wrong_predictions)\n",
    "most_confusing = wrong_counts.most_common(5)\n",
