    "from PIL import Image\n",
    "\n",
    "# --- Giữ nguyên 2 hàm tính toán tối ưu này ---\n",
    "def calculate_ap_1toN(retrieved_indices, ground_truth_indices):\n",
    "    is_relevant = np.isin(retrieved_indices, ground_truth_indices)\n",
    "    if not is_relevant.any(): return 0.0\n",
    "    hit_positions = np.where(is_relevant)[0] + 1\n",
    "    hits_cum = np.arange(1, len(hit_positions) + 1)\n",
    "    return np.sum(hits_cum / hit_positions) / len(ground_truth_indices)\n",
    "\n",
    "def calculate_precision_recall_at_k_1toN(retrieved_indices, ground_truth_indices, k):\n",
    "    retrieved_k = retrieved_indices[:k]\n",
    "    hits_at_k = np.isin(retrieved_k, ground_truth_indices).sum()\n",
    "    precision = hits_at_k / k\n",
    "    total_gt = len(ground_truth_indices)\n",
    "    recall = hits_at_k / total_gt if total_gt > 0 else 0.0\n",
    "    return precision, recall\n",
    "\n",
    "# --- CẤU HÌNH BATCHING ĐỂ KHỬ NGHẼN CỔ CHAI ---\n",
    "BATCH_SIZE = 1024  # Xử lý 1024 hàng cùng lúc. Bạn có thể tăng lên 2048 nếu GPU mạnh.\n",
    "k_values = [1, 5, 10]\n",
    "num_samples = len(text_features)\n",
    "\n",
    "ap_scores = []\n",
    "all_precisions = {k: [] for k in k_values}\n",
    "all_recalls = {k: [] for k in k_values}\n",
    "all_retrieved_for_analysis = []\n",
    "\n",
    "# Gom nhóm sẵn nhãn O(1)\n",
    "group_to_indices = candidate_df.groupby('label_group').indices\n",
    "\n",
    "print(f\"Đang tính toán metric theo Batch (Kích thước: {BATCH_SIZE})...\")\n",
    "\n",
    "# Vòng lặp nhảy cóc theo BATCH_SIZE\n",
    "for start_idx in range(0, num_samples, BATCH_SIZE):\n",
    "    end_idx = min(start_idx + BATCH_SIZE, num_samples)\n",
    "    \n",
    "    # 1. CẮT MỘT CỤM MA TRẬN TƯƠNG ĐỒNG\n",
    "    sim_batch = cosine_similarity_matrix[start_idx:end_idx]\n",
    "    \n",
    "    # 2. SẮP XẾP SONG SONG CẢ CỤM TRÊN GPU RỒI ĐẨY VỀ CPU 1 LẦN DUY NHẤT\n",
    "    # Tốc độ dòng này xử lý 1024 hàng sẽ nhanh tương đương xử lý 1 hàng trước đây\n",
    "    sorted_batch_indices = torch.argsort(sim_batch, descending=True, dim=-1).cpu().numpy()\n",
    "    \n",
    "    # 3. Tính toán metric trên CPU cho cụm hiện tại\n",
    "    for i in range(start_idx, end_idx):\n",
    "        # Lấy ra kết quả đã được sắp xếp của hàng thứ i từ trong batch\n",
    "        local_idx = i - start_idx\n",
    "        retrieved_indices = sorted_batch_indices[local_idx]\n",
    "        \n",
    "        current_label = candidate_df.iloc[i]['label_group']\n",
    "        ground_truth_indices = group_to_indices[current_label].tolist()\n",
    "        \n",
    "        # Tính AP\n",
    "        ap = calculate_ap_1toN(retrieved_indices, ground_truth_indices)\n",
    "        ap_scores.append(ap)\n",
    "        \n",
    "        # Tính P@K và R@K\n",
    "        for k in k_values:\n",
    "            p, r = calculate_precision_recall_at_k_1toN(retrieved_indices, ground_truth_indices, k)\n",
    "            all_precisions[k].append(p)\n",
    "            all_recalls[k].append(r)\n",
    "            \n",
    "        # Lưu Top 4 để phân tích ảnh lỗi\n",
    "        all_retrieved_for_analysis.append(retrieved_indices[:4])\n",
    "\n",
    "# ==========================================\n",
    "# CÁC BƯỚC IN BÁO CÁO & VẼ ĐỒ THỊ (GIỮ NGUYÊN)\n",
    "# ==========================================\n",
    "mean_mAP = np.mean(ap_scores)\n",
    "mean_precisions = {k: np.mean(all_precisions[k]) for k in k_values}\n",
    "mean_recalls = {k: np.mean(all_recalls[k]) for k in k_values}\n",
    "\n",
    "print(\"\\n==============================================\")\n",
    "print(\"   BÁO CÁO METRICS TRUNG BÌNH TOÀN TẬP (1-N)   \")\n",
    "print(\"==============================================\")\n",
    "print(f\"mAP Toàn tập: {mean_mAP:.4f}\")\n",
    "print(\"-\" * 46)\n",
    "for k in k_values:\n",
    "    print(f\"Precision@{k}: {mean_precisions[k]:.4f}  |  Recall@{k}: {mean_recalls[k]:.4f}\")\n",
    "print(\"==============================================\\n\")\n",
    "\n",
    "# Vẽ 3 ảnh tệ nhất\n",
    "ap_scores = np.array(ap_scores)\n",
    "worst_indices = np.argsort(ap_scores)[:3]\n",
    "\n",
    "for idx in worst_indices:\n",
    "    query_text = candidate_df.iloc[idx]['title']\n",
    "    img_name = candidate_df.iloc[idx]['image']\n",
    "    true_img_path = os.path.join(image_folder, img_name)\n",
    "    wrong_preds = all_retrieved_for_analysis[idx]\n",
    "    current_group = candidate_df.iloc[idx]['label_group']\n",
    "    \n",
    "    print(f\"Query: {query_text} | AP cá điểm: {ap_scores[idx]:.4f}\")\n",
    "    fig, axes = plt.subplots(1, 4, figsize=(15, 4))\n",
    "    \n",
    "    try:\n",
    "        true_img = Image.open(true_img_path)\n",
    "        axes[0].imshow(true_img)\n",
    "        axes[0].set_title(\"Query Image\", color='blue')\n",
    "        axes[0].axis('off')\n",
    "    except Exception:\n",
    "        axes[0].axis('off')\n",
    "        \n",
    "    for j in range(3):\n",
    "        pred_idx = wrong_preds[j]\n",
    "        pred_img_name = candidate_df.iloc[pred_idx]['image']\n",
    "        pred_img_path = os.path.join(image_folder, pred_img_name)\n",
    "        try:\n",
    "            pred_img = Image.open(pred_img_path)\n",
    "            axes[j+1].imshow(pred_img)\n",
    "            is_match = candidate_df.iloc[pred_idx]['label_group'] == current_group\n",
    "            color = 'green' if is_match else 'red'\n",
    "            axes[j+1].set_title(f\"Top {j+1} ({'MATCH' if is_match else 'MISMATCH'})\", color=color)\n",
    "            axes[j+1].axis('off')\n",
    "        except Exception:\n",
    "            axes[j+1].axis('off')\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
