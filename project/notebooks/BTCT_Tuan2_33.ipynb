    "def tim_query_dep(candidate_df, feature_matrix, so_luong=3):\n",
    "    labels = candidate_df['label_group'].values\n",
    "    features_norm = F.normalize(feature_matrix, p=2, dim=1)\n",
    "    \n",
    "    query_dep = []\n",
    "    \n",
    "    for query_idx in range(len(candidate_df)):\n",
    "        query_group = labels[query_idx]\n",
    "        \n",
    "        # Chỉ cần nhóm có ít nhất 2 ảnh (query + 1 ảnh đúng)\n",
    "        so_anh_cung_nhom = (labels == query_group).sum()\n",
    "        if so_anh_cung_nhom < 2:\n",
    "            continue\n",
    "        \n",
    "        scores = torch.mm(\n",
    "            features_norm[query_idx].unsqueeze(0),\n",
    "            features_norm.t()\n",
    "        ).squeeze()\n",
    "        scores[query_idx] = -1\n",
    "        \n",
    "        # Lấy top-5 để hiển thị đẹp\n",
    "        top5_idx = torch.topk(scores, min(5, len(labels)-1)).indices.tolist()\n",
    "        \n",
    "        # Kiểm tra top-1 đúng là đủ để demo\n",
    "        if labels[top5_idx[0]] == query_group:\n",
    "            query_dep.append(query_idx)\n",
    "        \n",
    "        if len(query_dep) >= so_luong:\n",
    "            break\n",
    "    \n",
    "    return query_dep\n",
    "\n",
    "print('Đang tìm ảnh query có top-1 đúng để demo...')\n",
    "cac_query_dep = tim_query_dep(candidate_df, feature_matrix, so_luong=3)\n",
    "\n",
    "if len(cac_query_dep) == 0:\n",
    "    print('Không tìm được!')\n",
    "else:\n",
    "    print(f'Tìm được {len(cac_query_dep)} query tại index: {cac_query_dep}')\n",
    "    for query_idx in cac_query_dep:\n",
    "        hien_thi_query_top5(\n",
    "            query_idx,\n",
    "            candidate_df,\n",
    "            feature_matrix,\n",
    "            IMAGE_DIR,\n",
    "            k=5\n",
    "        )"
   ]
