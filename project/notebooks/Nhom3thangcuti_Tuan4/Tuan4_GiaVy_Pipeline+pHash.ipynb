        "## 🍎 Cell 5: Tải MobileCLIP (hoặc Fallback CLIP)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "GJ_Yq2Av8eef",
        "outputId": "6b84c2ec-bf19-4938-defa-781a6d131362"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "⏬ Đang download checkpoint mobileclip_s0...\n",
            "✅ Đã lưu: /tmp/mobileclip_s0.pt\n",
            "⏳ Đang tải mobileclip_s0...\n",
            "\n",
            "✅ MobileCLIP (mobileclip_s0) đã sẵn sàng\n",
