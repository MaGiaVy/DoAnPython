    "print('=' * 60)\n",
    "\n",
    "# --- 2.1: Custom Dataset cho Shopee ---\n",
    "class ShopeeImageDataset(Dataset):\n",
    "    \"\"\"\n",
    "    Dataset tùy chỉnh để tải ảnh Shopee cho SigLIP.\n",
    "    Tự động xử lý ảnh lỗi bằng cách trả về ảnh đen.\n",
    "    \"\"\"\n",
    "    def __init__(self, image_dir: str, image_filenames: list, transform=None):\n",
    "        self.image_dir       = image_dir\n",
    "        self.image_filenames = image_filenames\n",
    "        self.transform       = transform\n",
    "\n",
    "    def __len__(self) -> int:\n",
    "        return len(self.image_filenames)\n",
    "\n",
    "    def __getitem__(self, idx: int):\n",
    "        img_path = os.path.join(self.image_dir, self.image_filenames[idx])\n",
    "        try:\n",
    "            img = Image.open(img_path).convert('RGB')\n",
    "        except Exception:\n",
    "            # Nếu không mở được ảnh → trả về ảnh xám đặc\n",
    "            img = Image.new('RGB', (IMG_SIZE, IMG_SIZE), (128, 128, 128))\n",
    "        if self.transform:\n",
    "            img = self.transform(img)\n",
    "        return img, idx\n",
    "\n",
    "\n",
    "# --- 2.2: Transform theo chuẩn SigLIP (mean/std = 0.5) ---\n",
    "siglip_transform = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE), interpolation=transforms.InterpolationMode.BICUBIC),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(\n",
    "        mean=[0.5, 0.5, 0.5],  # SigLIP mean\n",
    "        std=[0.5, 0.5, 0.5]    # SigLIP std\n",
    "    ),\n",
    "])\n",
    "\n",
    "print('✅ Đã tạo ShopeeImageDataset và Transform cho SigLIP!')\n"
   ]
